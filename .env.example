# Copy to .env. Never commit the real key.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

# Default economical models
ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
TRANSLATION_MODEL=qwen-flash

# Local video high-quality batch mode (independent from realtime models)
BATCH_ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
BATCH_TRANSLATION_MODEL=qwen-plus

# Optional native process-loopback helper path
PROCESS_AUDIO_HELPER_PATH=
